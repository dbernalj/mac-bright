# Variables de entorno del backend (api/). NUNCA se commitea un .env real con valores
# verdaderos — estas se configuran solo en el dashboard de Vercel (Project Settings →
# Environment Variables). Este archivo solo documenta los nombres esperados.

# Obtener con: turso db show mac-bright --url
TURSO_DATABASE_URL=

# Obtener con: turso db tokens create mac-bright
TURSO_AUTH_TOKEN=

# Contraseña única compartida para entrar al panel de administración (admin.html).
# Elige una frase larga y única — no reutilices otra contraseña.
ADMIN_PASSWORD=
